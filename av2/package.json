{
  "name": "greencode-monolith",
  "version": "1.0.0",
  "description": "GreenCode - Monólito Servidor Web com Fastify, TypeScript e Prisma ORM (AV2)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "test:api": "tsx scripts/test-api.ts",
    "test": "npm run test:api"
  },
  "keywords": [
    "greencode",
    "fastify",
    "typescript",
    "prisma",
    "postgresql",
    "sqlite",
    "monolith",
    "jwt",
    "logistica-reversa"
  ],
  "author": "Equipe GreenCode",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@prisma/client": "^5.18.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^5.18.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
